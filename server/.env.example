PORT=5000

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION: MongoDB Atlas
# -----------------------------------------------------------------------------
# Replace <username>, <password>, and <cluster> with your MongoDB Atlas details.
# Note: If your password contains special characters (@, :, /, #), URL-encode them (e.g., '@' -> '%40').
# Target Database: 'itam'
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/itam?retryWrites=true&w=majority

# Local MongoDB (Disabled):
# MONGO_URI=mongodb://localhost:27017/itam

# -----------------------------------------------------------------------------
# SECURITY & ENVIRONMENT
# -----------------------------------------------------------------------------
JWT_SECRET=itam_super_secret_jwt_key_2026_secure
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
