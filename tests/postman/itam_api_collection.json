  "item": [
    {
      "name": "00 - Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health check returns 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Status is healthy', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('healthy');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Auth: Setup Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/auth/setup-status", "host": ["{{baseUrl}}"], "path": ["auth", "setup-status"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Setup status returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "    var data = pm.response.json();",
              "    pm.expect(data.success).to.be.true;",
              "    pm.collectionVariables.set('isSystemInitialized', data.initialized);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Auth: Setup Initial Admin (If uninitialized)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{adminName}}\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/setup-admin", "host": ["{{baseUrl}}"], "path": ["auth", "setup-admin"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    pm.test('Initial admin setup successful', function () {",
              "        var data = pm.response.json();",
              "        pm.expect(data.success).to.be.true;",
              "        pm.expect(data.token).to.be.a('string');",
              "        pm.collectionVariables.set('adminToken', data.token);",
              "    });",
              "} else if (pm.response.code === 400 || pm.response.code === 409) {",
              "    pm.test('System already initialized or conflict', function () {",
              "        pm.expect(pm.response.code).to.be.oneOf([400, 409]);",
              "    });",
              "} else {",
              "    pm.test('Unexpected status code on setup', function () {",
              "        pm.expect(pm.response.code).to.be.oneOf([201, 400, 409]);",
              "    });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "01 - Auth: Admin Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin login successful (200 OK)', function () {",
              "    pm.response.to.have.status(200);",
              "    var data = pm.response.json();",
              "    pm.expect(data.success).to.be.true;",
              "    pm.expect(data.token).to.be.a('string');",
              "    pm.expect(data.user.role).to.eql('ADMIN');",
              "    pm.collectionVariables.set('adminToken', data.token);",
              "    pm.collectionVariables.set('adminId', data.user._id || data.user.id);",
              "});"
            ]
          }
        }
      ]
