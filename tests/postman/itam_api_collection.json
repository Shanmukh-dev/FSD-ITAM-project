{
  "info": {
    "_postman_id": "itam-enterprise-api-suite-v1",
    "name": "IT Asset Management (ITAM) API Test Suite",
    "description": "Comprehensive Postman test collection for IT Asset Management REST APIs covering Auth, Users, Departments, Assets, Assignments, Requests, Maintenance, Dashboards, Reports, and Notifications.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api", "type": "string" },
    { "key": "adminEmail", "value": "admin@enterprise.corp", "type": "string" },
    { "key": "adminPassword", "value": "Password123!", "type": "string" },
    { "key": "adminName", "value": "Primary Administrator", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "managerToken", "value": "", "type": "string" },
    { "key": "techToken", "value": "", "type": "string" },
    { "key": "employeeToken", "value": "", "type": "string" },
    { "key": "createdDeptId", "value": "", "type": "string" },
    { "key": "createdUserId", "value": "", "type": "string" },
    { "key": "createdAssetId", "value": "", "type": "string" },
    { "key": "createdAssignmentId", "value": "", "type": "string" },
    { "key": "createdRequestId", "value": "", "type": "string" },
    { "key": "createdTicketId", "value": "", "type": "string" },
    { "key": "createdNotificationId", "value": "", "type": "string" }
